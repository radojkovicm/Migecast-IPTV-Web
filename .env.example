# Supply real values locally; never commit .env or print secrets.
DATABASE_URL=postgresql://migecast:replace-locally@127.0.0.1:55439/migecast
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3100
# One-time provisioning only; supply through a secure local environment:
# ADMIN_USERNAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Separate source-encryption key: generate 32 random bytes and encode as 64 hex characters.
# Back up securely; changing it makes existing sources unreadable without migration.
PLAYLIST_ENCRYPTION_KEY=

# Optional local worker; export its variables separately for pnpm worker:start.
MEDIA_WORKER_URL=http://127.0.0.1:3101
MEDIA_WORKER_SECRET=
# Worker-only defaults (do not expose its port through nginx):
# MEDIA_WORKER_PORT=3101
# MEDIA_WORKER_MAX_JOBS=1
# MEDIA_ALLOW_VIDEO_TRANSCODE=0
# FFMPEG_PATH=/absolute/path/to/ffmpeg
# FFPROBE_PATH=/absolute/path/to/ffprobe

# Linux isolated service only: require a private tmpfs no larger than 256 MiB.
# MEDIA_WORKER_REQUIRE_TMPFS=1
