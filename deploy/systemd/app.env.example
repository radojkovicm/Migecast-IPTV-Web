# Root-owned 0600 /etc/migecast/app.env. Supply secrets securely, never commit.
# These candidate ports must be checked against the host before installation.
HOSTNAME=127.0.0.1
PORT=3100
DATABASE_URL=postgresql://migecast:REPLACE_LOCALLY@127.0.0.1:55439/migecast
BETTER_AUTH_URL=https://migecast.example.com
BETTER_AUTH_SECRET=
PLAYLIST_ENCRYPTION_KEY=
MEDIA_WORKER_URL=http://127.0.0.1:3101
MEDIA_WORKER_SECRET=
# No ADMIN_PASSWORD after one-time provisioning. No MEDIA_TEST_ORIGIN in production.
