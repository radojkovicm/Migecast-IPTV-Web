# Manual candidate; validate on the target Linux release before installation.
[Unit]
Description=Migecast private web app
After=network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=migecast-app
Group=migecast-app
WorkingDirectory=/opt/migecast-app/current
EnvironmentFile=/etc/migecast/app.env
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/opt/migecast-worker/runtime/bin/node --max-old-space-size=384 /opt/migecast-app/current/server.js
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=15
OOMPolicy=stop
UMask=0077
LimitCORE=0
LimitNOFILE=1024
CPUAccounting=yes
CPUQuota=100%
MemoryAccounting=yes
MemoryHigh=512M
MemoryMax=640M
MemorySwapMax=0
TasksAccounting=yes
TasksMax=128
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TemporaryFileSystem=/tmp:rw,nosuid,nodev,noexec,size=64M,mode=1777
InaccessiblePaths=/var/tmp /etc/migecast /opt/migecast-worker/releases
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
