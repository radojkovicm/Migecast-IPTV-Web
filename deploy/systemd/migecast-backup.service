# Manual candidate: Docker group access is host-privileged, not a sandbox.
[Unit]
Description=Verify and retain dedicated Migecast PostgreSQL backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=migecast-backup
Group=migecast-backup
SupplementaryGroups=docker
Environment=APP_DIR=/opt/migecast-db
Environment=BACKUP_DIR=/var/backups/migecast
Environment=KEEP=14
ExecStart=/usr/bin/bash /opt/migecast-backup/backup-postgres.sh
TimeoutStartSec=15min
TimeoutStopSec=20
KillMode=control-group
UMask=0077
LimitCORE=0
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/backups/migecast
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
StandardOutput=journal
StandardError=journal
