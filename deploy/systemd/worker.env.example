# Root-owned 0600 /etc/migecast/worker.env. Never use the web app's .env.
# Generate an independent 32-byte hex key; share only this key with the app.
MEDIA_WORKER_SECRET=
# Select an unused loopback port on the target host; 3101 is only a candidate.
MEDIA_WORKER_PORT=3101
MEDIA_WORKER_MAX_JOBS=1
MEDIA_ALLOW_VIDEO_TRANSCODE=0
