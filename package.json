{
	"name": "migecast-iptv-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.28.2",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "next dev --hostname 127.0.0.1 --port 3100",
		"build": "prisma generate && next build",
		"start": "next start --hostname 127.0.0.1 --port 3100",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"lint": "biome check .",
		"format": "biome check --write .",
		"db:generate": "prisma generate",
		"db:deploy": "prisma migrate deploy",
		"admin:create": "tsx scripts/create-admin.ts",
		"test:integration": "node scripts/test-integration.mjs",
		"worker:build": "tsc -p tsconfig.worker.json",
		"worker:start": "node dist/worker/main.js",
		"test:worker": "pnpm worker:build && node scripts/test-worker.mjs",
		"release:package": "node scripts/package-release.mjs",
		"test:release": "node --test scripts/test-release.mjs scripts/test-verify-release.mjs scripts/test-operator-package.mjs scripts/test-backup.mjs",
		"release:verify": "node scripts/verify-release.mjs",
		"test:release-runtime": "node scripts/test-release-runtime.mjs",
		"demo:build": "node demo/build.mjs",
		"demo:test": "node --test demo/catalog.test.mjs && node demo/test.mjs",
		"demo:sync": "node demo/sync-catalog.mjs"
	},
	"dependencies": {
		"@node-rs/argon2": "2.2.2",
		"@prisma/adapter-pg": "7.10.1",
		"@prisma/client": "7.10.1",
		"better-auth": "1.7.12",
		"hls.js": "1.7.3",
		"ipaddr.js": "2.5.0",
		"next": "16.4.2",
		"pg": "8.23.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"server-only": "0.0.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@playwright/test": "1.64.1",
		"@types/node": "22.19.7",
		"@types/pg": "8.23.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"prisma": "7.10.1",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	},
	"license": "MIT"
}
